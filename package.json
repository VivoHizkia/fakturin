{
  "name": "faktur-otomatis",
  "version": "0.1.0",
  "private": true,
  "description": "Mengubah foto faktur menjadi data terstruktur, dengan antrean periksa untuk yang meragukan",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "contoh": "tsx scripts/buat-contoh.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
