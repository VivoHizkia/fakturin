# Kunci untuk endpoint Chat Completions yang kompatibel dengan OpenAI.
# Bawaan: Gemini lewat Google AI Studio (gratis). https://aistudio.google.com/apikey
LLM_API_KEY=

# Opsional. Ganti kalau memakai penyedia lain (Groq, OpenAI, OpenRouter, Ollama lokal).
LLM_BASE_URL=
LLM_MODEL=
# Dipakai hanya kalau LLM_MODEL terus menjawab "sibuk" (429/503). Kosongkan untuk mematikan.
LLM_FALLBACK_MODEL=

# Opsional. Setiap dokumen yang disetujui dikirim ke alamat ini sebagai JSON.
WEBHOOK_URL=
# Kunci untuk tanda tangan HMAC di header X-Faktur-Tanda-Tangan.
WEBHOOK_SECRET=

# Opsional. Folder data lokal (bawaan: .data) dan batas unggahan per hari (bawaan: 30).
DATA_DIR=
BATAS_UNGGAH_HARIAN=
